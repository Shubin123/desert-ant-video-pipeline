    "frames": 136,
    "topic": "Stock and exchange, watch list and item, and order and trade."
   },
   {
    "start": 5.433333333333334,
    "end": 11.6,
    "frames": 185,
    "topic": "We're going to test each of these schemas to learn how to mathematically prove that a database decomposition is a lossless join."
   },
   {
    "start": 12.966666666666667,
    "end": 17,
    "frames": 121,
    "topic": "When we design a relational database, we use a process called normalization."
   },
   {
    "start": 17.666666666666668,
    "end": 23.6,
    "frames": 178,
    "topic": "We break down massive, unwieldy tables into smaller, distinct tables to eliminate redundant data."
   },
   {
    "start": 23.6,
    "end": 29.666666666666668,
    "frames": 182,
    "topic": "A common assumption is that a lossy join means data gets deleted or lost during this split."
   },
   {
    "start": 30.366666666666667,
    "end": 31.266666666666666,
    "frames": 27,
    "topic": "The opposite is true."
   },
   {
    "start": 31.733333333333334,
    "end": 36.13333333333333,
    "frames": 132,
    "topic": "If tables are split incorrectly, the database has to guess how to put them back together."
   },
   {
    "start": 136.93333333333334,
    "end": 137.46666666666667,
    "frames": 16,
    "topic": "Look at this mapping."
   },
   {
    "hold": 137.43333333333334,
    "frames": 187,
    "voiceover": "Closing explanation"
   }
  ]
 },
